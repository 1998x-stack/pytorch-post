  "claims": [
    {
      "id": "view-1",
      "kind": "implementation",
      "statement": "Ordinary dense transpose swaps size and stride dimensions and delegates to as_strided; view_impl requires computeStride to produce compatible strides.",
      "evidence": [
        "transpose",
        "view",
        "compute-stride"
      ],
      "limitation": "Sparse and special layout paths differ.",
      "status": "verified"
    },
    {
      "id": "view-2",
      "kind": "implementation",
      "statement": "reshape_symint uses view for contiguous input, otherwise tests computeStride and uses alias or falls back to contiguous clone plus unsafe view.",
      "evidence": [
        "reshape",
        "compute-stride"
      ],
      "limitation": "Ordinary dense path, not a universal alias guarantee.",
      "status": "verified"
    },
    {
      "id": "view-3",
      "kind": "measured",
      "statement": "Transpose of 3×4 has (1,4) stride and shares storage; flatten view fails, reshape copies. A non-contiguous step-2 slice can flatten using view with stride (2,).",
      "evidence": [
        "transpose",
        "view",
        "reshape",
        "view-doc"
      ],
      "limitation": "Specific nonempty CPU sample; shape and stride determine feasibility, not is_contiguous alone.",
      "status": "verified",
