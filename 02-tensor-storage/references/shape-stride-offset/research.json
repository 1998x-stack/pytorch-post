  "claims": [
    {
      "id": "stride-1",
      "kind": "deduction",
      "statement": "For a nonempty ordinary tensor, element index in storage = offset + sum(i_d × stride_d); byte address = base + itemsize × index.",
      "evidence": [
        "layout",
        "offset",
        "as-strided",
        "storage-doc"
      ],
      "limitation": "Element strides and offsets, not byte strides; nonnegative indices within shape.",
      "status": "verified"
    },
    {
      "id": "stride-2",
      "kind": "deduction",
      "statement": "For nonnegative strides, maximum reached index is offset + sum((size_d−1) × stride_d); nonempty storage requires (max_index+1) × itemsize bytes or more.",
      "evidence": [
        "bounds",
        "set-strided"
      ],
      "limitation": "Only nonempty tensors and nonnegative strides; empty layouts have distinct checks.",
      "status": "verified"
    },
    {
      "id": "stride-3",
      "kind": "measured",
      "statement": "An explicit Python offset enumerator matches three native as_strided layouts, including zero stride, and out-of-bounds as_strided raises RuntimeError.",
      "evidence": [
        "as-strided",
        "bounds",
        "set-strided"
      ],
      "limitation": "Read-only test of overlap; never write through overlapping layout.",
      "status": "verified",
      "run_id": "cpu-check"
    }
  ],
