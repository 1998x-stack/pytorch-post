  "claims": [
    {
      "id": "obj-1",
      "kind": "implementation",
      "statement": "TensorBase holds an intrusive pointer to TensorImpl; TensorImpl contains Storage and layout metadata, while Storage points to StorageImpl containing DataPtr and byte length.",
      "evidence": [
        "tensor-handle",
        "tensor-storage",
        "tensor-layout",
        "storage-handle",
        "storage-impl"
      ],
      "limitation": "Ordinary storage-backed dense tensors; not all layouts expose storage.",
      "status": "verified"
    },
    {
      "id": "obj-2",
      "kind": "implementation",
      "statement": "A strided view can create a new TensorImpl sharing Storage; a nonempty ordinary tensor data pointer includes byte offset = element_size × storage_offset.",
      "evidence": [
        "alias",
        "data-offset"
      ],
      "limitation": "Empty tensors and specialized backends need separate treatment.",
      "status": "verified"
    },
    {
      "id": "obj-3",
      "kind": "measured",
      "statement": "A 3×4 int64 base and its 3×2 slice share 96 storage bytes; clone owns 48 bytes; slice mutation changes base but not clone.",
      "evidence": [
        "storage-doc",
        "views-doc",
        "alias"
      ],
      "limitation": "One nonempty CPU sample; pointer equality is not a universal ownership test.",
      "status": "verified",
      "run_id": "cpu-check"
    }
  ],
