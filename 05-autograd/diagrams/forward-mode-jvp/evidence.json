  "claims": [
    {
      "id": "jvp-1",
      "kind": "deduction",
      "statement": "For f: R^n→R^m, a tangent v∈R^n propagates as Jv∈R^m; a VJP instead maps an output cotangent back to input space.",
      "evidence": [
        "baydin"
      ],
      "limitation": "Real differentiable functions; no complexity claim for arbitrary kernels.",
      "status": "verified"
    },
    {
      "id": "jvp-2",
      "kind": "implementation",
      "statement": "make_dual embeds a tangent and aliases the primal; unpack_dual retrieves primal/tangent; exiting a dual level removes its associated gradients. torch.func.jvp constructs duals and unpacks outputs.",
      "evidence": [
        "dual",
        "unpack",
        "jvp",
        "fw-meta"
      ],
      "limitation": "The low-level API supports only one dual level; transforms have additional nesting logic.",
      "status": "verified"
    },
    {
      "id": "jvp-3",
      "kind": "measured",
      "statement": "At x=[2,3] and v=[4,5], f(x)=[6,5], Jv=[22,9]; torch.func.jvp agrees with jacrev(f) @ v, and unpack after exiting returns no tangent.",
      "evidence": [
        "dual",
        "unpack",
        "jvp"
      ],
      "limitation": "Small deterministic CPU example.",
      "status": "verified",
