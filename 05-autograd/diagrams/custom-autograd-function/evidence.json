  "claims": [
    {
      "id": "fn-1",
      "kind": "implementation",
      "statement": "FunctionMeta creates a backward class; regular Function.apply delegates to C++ apply, which sets next edges and calls forward with grad mode disabled. PyNode::apply calls back into Python.",
      "evidence": [
        "meta",
        "apply",
        "bridge",
        "pynode"
      ],
      "limitation": "Normal eager route; functorch transforms have a separate branch.",
      "status": "verified"
    },
    {
      "id": "fn-2",
      "kind": "implementation",
      "statement": "backward receives one output gradient per output and returns gradients matching forward inputs; tensors for backward use save_for_backward.",
      "evidence": [
        "ctx",
        "contract"
      ],
      "limitation": "Non-Tensor scalar input returns None; higher-order support depends on differentiable backward and saved values.",
      "status": "verified"
    },
    {
      "id": "fn-3",
      "kind": "measured",
      "statement": "ScaledCube at x=[2,-1], scale=2 produces [16,-2], gradient [24,6], second [24,-12], passes gradcheck and gradgradcheck; deliberately wrong square backward is rejected.",
      "evidence": [
        "contract",
        "ctx"
      ],
      "limitation": "CPU float64 examples; no generic guarantee for all inputs or transforms.",
      "status": "verified",
      "run_id": "cpu-check"
    }
