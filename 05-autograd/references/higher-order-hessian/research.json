  "claims": [
    {
      "id": "hvp-1",
      "kind": "deduction",
      "statement": "For a twice continuously differentiable scalar f, H v is JVP of grad(f); reverse differentiation of grad(f) with seed v returns H^T v, equal by symmetry.",
      "evidence": [
        "baydin",
        "hessian"
      ],
      "limitation": "Real C² scalar f, fixed seed independent of x.",
      "status": "verified"
    },
    {
      "id": "hvp-2",
      "kind": "implementation",
      "statement": "torch.func.hessian returns jacfwd(jacrev(func)); autograd.grad(create_graph=True) constructs derivative graph, while retain_graph concerns freeing the original graph.",
      "evidence": [
        "grad",
        "hessian"
      ],
      "limitation": "Forward AD operator coverage may be incomplete.",
      "status": "verified"
    },
    {
      "id": "hvp-3",
      "kind": "measured",
      "statement": "For f=x₁³+x₁x₂+x₂² at (2,3), grad=[15,8], H=[[12,1],[1,2]], and both HVP routes yield [53,14]; default create_graph=False rejects this second derivative.",
      "evidence": [
        "grad",
        "hessian",
        "jvp"
      ],
      "limitation": "A polynomial CPU example only.",
      "status": "verified",
      "run_id": "cpu-check"
    }
  ],
