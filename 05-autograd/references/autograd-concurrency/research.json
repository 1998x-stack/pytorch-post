  "claims": [
    {
      "id": "conc-1",
      "kind": "implementation",
      "statement": "Engine ready queues route CPU work and device work; a nested backward can block a worker, so the engine has a worker pool mechanism for reentrant work.",
      "evidence": [
        "queue",
        "routing",
        "reentrant"
      ],
      "limitation": "The pool mechanism is not asserted to be used in every nested backward; CPU and accelerator routes differ.",
      "status": "verified"
    },
    {
      "id": "conc-2",
      "kind": "implementation",
      "statement": "For CUDA/privateuse1 the engine associates backward device work with forward streams; producer-consumer synchronization and accumulation stream choices are described in InputBuffer.",
      "evidence": [
        "reentrant",
        "stream"
      ],
      "limitation": "Source-level contract only; CUDA unavailable. No claim about exact kernel overlap or latency.",
      "status": "verified"
    },
    {
      "id": "conc-3",
      "kind": "measured",
      "statement": "Two independent CPU graph tasks return gradients 4 and 6; a custom backward that invokes torch.autograd.grad returns gradient 6.",
      "evidence": [
        "reentrant",
        "mechanics"
      ],
      "limitation": "Correctness and completion only; no shared-leaf race or concurrency speedup measurement.",
      "status": "verified",
