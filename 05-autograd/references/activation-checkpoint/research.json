  "claims": [
    {
      "id": "ckpt-1",
      "kind": "paper",
      "statement": "For equal-sized sequential layers split into k segments, Chen et al. derive activation storage O(n/k+k), minimized in order at k≈sqrt(n).",
      "evidence": [
        "chen"
      ],
      "limitation": "Idealized equal-size sequential activation model, not measured total GPU memory or universal guarantee.",
      "status": "verified"
    },
    {
      "id": "ckpt-2",
      "kind": "implementation",
      "statement": "Reentrant uses a custom Function, no_grad forward and whole-function recomputation; non-reentrant uses saved tensor hooks and can stop when needed tensors are restored. RNG preservation forks/restores CPU and supported device state.",
      "evidence": [
        "reentrant",
        "api",
        "early",
        "hooks",
        "rng"
      ],
      "limitation": "Early-stop, device, stochastic and mutable-state constraints matter.",
      "status": "verified"
    },
    {
      "id": "ckpt-3",
      "kind": "measured",
      "statement": "Plain, non-reentrant and reentrant produce [32,108] gradients. The non-reentrant trace ends at a second enter, reentrant reaches second exit; fixed-seed Dropout output, gradient and CPU RNG state match baseline.",
      "evidence": [
        "reentrant",
        "early",
        "hooks",
